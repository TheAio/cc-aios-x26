SOFTRESET
STORE STRING "/.boot/init/" 1000
STORE STRING ".prgm" 1001
STORE NUMBER 0 1002
STORE NUMBER 1 1
STORE NUMBER 3 3
STORE NUMBER 1000 2001
STORE NUMBER 1 9001
LABEL EXIT NUMBER 20
LABELLINE FIND_INIT
ADD 1 1002 1002
CONCAT 1002 1000 1003
CONCAT 1001 1003 1003
STORE NUMBER 1 2000
LOAD 1003 2000
JUMPIF 1002 2001 EXIT
JUMPIF 2000 1 FIND_INIT
RUN 2000
RESET

ADD 1 9001 9001
LABEL NODISK NUMBER 28
JUMPIF 3 9001 NODISK

STORE STRING "/disk/.boot/init/" 1000
STORE NUMBER 0 1002
JUMPIF 1002 1002 FIND_INIT

STORE STRING "NO INIT FILE FOUND, ENTER DISK AND STRIKE ANY KEY" 4000
PRINT 4000
LIVEINPUT 1
RESET
